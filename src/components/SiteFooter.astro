---
import { SITE } from '../config';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="dj-logo" style="font-size: 18px;">{SITE.logo.replace('_', '')}<span>_</span></span>
      <span class="footer-tagline">Apuntes de TI, comandos y laboratorio. Escrito por {SITE.author} en {SITE.city}.</span>
    </div>
    <nav aria-label="Enlaces" class="footer-links">
      <a href={SITE.github}>GitHub</a>
      <a href={SITE.linkedin}>LinkedIn</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface-muted);
  }
  .footer-inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-muted);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-tagline {
    color: var(--ink-muted);
  }
  .footer-links {
    display: flex;
    gap: 20px;
    font-weight: 500;
  }
  .footer-links a {
    color: var(--heading);
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
</style>
