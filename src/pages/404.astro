---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — dajomar" description="Página no encontrada.">
  <div class="not-found">
    <div class="terminal-block">
      <span class="dj-prompt">
        <span class="dj-prompt__user">david@dajomar</span><span class="dj-prompt__sep">:</span><span class="dj-prompt__path">~</span><span class="dj-prompt__sep">$ </span>cd /ruta
      </span>
      <p class="error-msg">bash: cd: /ruta: No existe el archivo o el directorio</p>
    </div>
    <a href="/" class="dj-btn dj-btn--primary">Volver al inicio</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    min-height: 50vh;
    padding: var(--space-16) var(--space-6);
    text-align: center;
  }
  .terminal-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .error-msg {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 22px;
    color: var(--danger);
  }
</style>
