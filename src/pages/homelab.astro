---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Homelab — dajomar" description="Notas sobre mi homelab: hardware, servicios y configuración.">
  <div class="content-width" style="padding-top: 40px; padding-bottom: 72px;">
    <h1 class="page-title">Homelab</h1>
    <p>[DESCRIBIR EL HOMELAB]</p>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-size: 34px;
    line-height: 40px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--line);
  }
</style>
